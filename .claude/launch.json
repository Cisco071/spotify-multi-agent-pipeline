{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "review-server",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "evals/review_server.py"
      ],
      "port": 8765
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
